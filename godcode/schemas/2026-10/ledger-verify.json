{"$id":"https://getgodcode.com/schemas/2026-10/ledger-verify.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"The machine shape of godcode ledger verify --json: attesting the covenant chain and the anchor chain for tampering. Exit 0 when both verify, 1 when either fails. Additive fields may appear in future; the fields listed as required never change meaning.","properties":{"anchors":{"additionalProperties":true,"description":"The anchor chain's attestation","properties":{"message":{"type":"string"},"ok":{"type":"boolean"}},"required":["ok","message"],"type":"object"},"command":{"const":"ledger","type":"string"},"covenant":{"additionalProperties":true,"description":"The covenant chain's attestation","properties":{"message":{"type":"string"},"ok":{"type":"boolean"}},"required":["ok","message"],"type":"object"},"ok":{"description":"True when both chains verify","type":"boolean"},"subcommand":{"const":"verify","type":"string"},"tool":{"const":"godcode","type":"string"}},"required":["tool","command","subcommand","ok","covenant","anchors"],"title":"God Code ledger verify report","type":"object"}