{"$id": "https://getgodcode.com/schemas/2026-10/explain.json", "$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": true, "description": "The machine shape of godcode explain --json: the static facts of a scroll, read without running it. When ok is true the facts are present; on file or parse trouble (ok false) only the envelope and diagnostics appear. Exit 0 when ok, 1 on file or parse trouble, 2 on usage error. Additive fields may appear in future; the fields listed as required never change meaning.", "properties": {"command": {"const": "explain", "type": "string"}, "consults": {"description": "Every CONSULT call", "items": {"additionalProperties": true, "properties": {"line": {"type": "integer"}}, "required": ["line"], "type": "object"}, "type": "array"}, "declarations": {"description": "Every DECLARE, at any depth", "items": {"additionalProperties": true, "properties": {"line": {"type": "integer"}, "name": {"type": "string"}}, "required": ["name", "line"], "type": "object"}, "type": "array"}, "diagnostics": {"description": "Empty when the scroll was read; carries FILE_ERROR or a parse diagnostic on failure", "items": {"additionalProperties": true, "properties": {"code": {"type": "string"}, "col": {"type": ["integer", "null"]}, "hint": {"type": ["string", "null"]}, "line": {"type": ["integer", "null"]}, "message": {"type": "string"}, "severity": {"type": "string"}}, "required": ["line", "col", "code", "severity", "message", "hint"], "type": "object"}, "type": "array"}, "file": {"description": "The scroll that was explained", "type": "string"}, "imports": {"description": "Every IMPORT", "items": {"additionalProperties": true, "properties": {"line": {"type": "integer"}, "path": {"type": "string"}}, "required": ["path", "line"], "type": "object"}, "type": "array"}, "intents": {"description": "Every DECLARE INTENT", "items": {"additionalProperties": true, "properties": {"line": {"type": "integer"}, "rite": {"type": "string"}, "text": {"type": "string"}}, "required": ["rite", "text", "line"], "type": "object"}, "type": "array"}, "ok": {"description": "True when the scroll was read and explained", "type": "boolean"}, "permissions": {"additionalProperties": true, "description": "The scroll's permission manifest", "properties": {"network": {"items": {"type": "string"}, "type": "array"}, "read": {"items": {"type": "string"}, "type": "array"}, "stdin": {"type": "boolean"}, "summon": {"items": {"type": "string"}, "type": "array"}, "write": {"items": {"type": "string"}, "type": "array"}}, "required": ["read", "write", "network", "stdin", "summon"], "type": "object"}, "reveals": {"description": "Every REVEAL", "items": {"additionalProperties": true, "properties": {"line": {"type": "integer"}}, "required": ["line"], "type": "object"}, "type": "array"}, "rites": {"description": "Every DEFINE RITE, in document order", "items": {"additionalProperties": true, "properties": {"intent": {"description": "The DECLARE INTENT text for this rite, or null", "type": ["string", "null"]}, "line": {"type": "integer"}, "name": {"type": "string"}, "params": {"items": {"type": "string"}, "type": "array"}}, "required": ["name", "params", "line", "intent"], "type": "object"}, "type": "array"}, "seals": {"description": "SEAL statements and ANCHOR calls", "items": {"additionalProperties": true, "properties": {"kind": {"description": "SEAL for a covenant seal, ANCHOR for an anchored chain seal", "enum": ["SEAL", "ANCHOR"]}, "line": {"type": "integer"}}, "required": ["line", "kind"], "type": "object"}, "type": "array"}, "summons": {"description": "Every SUMMON call", "items": {"additionalProperties": true, "properties": {"line": {"type": "integer"}, "verb": {"description": "The summoned verb's name, null when not a plain word", "type": ["string", "null"]}}, "required": ["verb", "line"], "type": "object"}, "type": "array"}, "tongue": {"additionalProperties": true, "description": "The scroll's tongue", "properties": {"code": {"description": "Tongue code, en for English", "type": "string"}, "name": {"description": "Language name, e.g. English, Setswana", "type": "string"}}, "required": ["code", "name"], "type": "object"}, "tool": {"const": "godcode", "type": "string"}}, "title": "God Code explain report", "type": "object", "allOf": [{"required": ["tool", "command", "file", "ok", "diagnostics"]}, {"if": {"properties": {"ok": {"const": true}}, "required": ["ok"]}, "then": {"required": ["tongue", "rites", "intents", "declarations", "permissions", "reveals", "seals", "summons", "consults", "imports"]}, "else": true}]}