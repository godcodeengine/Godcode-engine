{"$id": "https://getgodcode.com/schemas/2026-10/run.json", "$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": true, "description": "The machine shape of godcode run --sandbox --json: running a scroll and capturing its output. Exit 0 when the run finished cleanly, 1 when it failed, 2 on usage error. Additive fields may appear in future; the fields listed as required never change meaning.", "properties": {"command": {"const": "run", "type": "string"}, "error": {"additionalProperties": true, "description": "Null on a clean run; the failure on a failed run", "properties": {"code": {"description": "Stable machine code, e.g. RUNTIME_ERROR, FILE_ERROR", "type": "string"}, "col": {"type": ["integer", "null"]}, "hint": {"type": ["string", "null"]}, "line": {"type": ["integer", "null"]}, "message": {"type": "string"}, "severity": {"type": "string"}, "trace": {"description": "Rite call trace, oldest call first; empty at the top level", "items": {"additionalProperties": true, "properties": {"line": {"type": ["integer", "null"]}, "rite": {"type": ["string", "null"]}}, "required": ["rite", "line"], "type": "object"}, "type": "array"}}, "required": ["line", "col", "code", "severity", "message", "hint"], "type": ["object", "null"]}, "file": {"description": "The scroll that was run", "type": "string"}, "intents": {"description": "One entry per invoked rite carrying a DECLARE INTENT, with declared, discerned, confidence, and aligned", "items": {"additionalProperties": true, "type": "object"}, "type": "array"}, "ok": {"description": "True when the run finished without error", "type": "boolean"}, "output": {"description": "Every line revealed during the run, in order", "items": {"type": "string"}, "type": "array"}, "permissions": {"additionalProperties": true, "description": "The run's permission manifest", "properties": {"network": {"items": {"type": "string"}, "type": "array"}, "read": {"items": {"type": "string"}, "type": "array"}, "stdin": {"type": "boolean"}, "summon": {"items": {"type": "string"}, "type": "array"}, "write": {"items": {"type": "string"}, "type": "array"}}, "type": "object"}, "seals": {"description": "Covenant blocks sealed during the run, in block order", "items": {"additionalProperties": true, "properties": {"block": {"description": "Ledger block index", "type": ["integer", "null"]}, "hash": {"description": "Block hash", "type": "string"}}, "required": ["block", "hash"], "type": "object"}, "type": "array"}, "stats": {"additionalProperties": true, "properties": {"ms": {"description": "Wall-clock milliseconds the run took", "type": "integer"}}, "required": ["ms"], "type": "object"}, "tool": {"const": "godcode", "type": "string"}}, "required": ["tool", "command", "file", "ok", "output", "seals", "intents", "permissions", "error", "stats"], "title": "God Code run report", "type": "object"}