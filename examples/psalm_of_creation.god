# Psalm of Creation. A bare word spoken with the mark is a symbol:
# :pure, :willing. No declaration of type is needed, for the word
# itself is the value.
BEGIN CREATION
  DECLARE heart AS :pure
  DECLARE hands AS :willing
  IF heart IS :pure THEN
    IF hands IS :willing THEN
      REVEAL("the work is blessed")
    ELSE
      REVEAL("wait and be still")
    ENDIF
  ELSE
    REVEAL("first, be cleansed")
  ENDIF
  ASCEND
END CREATION
