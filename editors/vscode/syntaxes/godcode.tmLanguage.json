{
  "fileTypes": [
    "god",
    "godcode"
  ],
  "name": "God Code",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#keyword-structure"
    },
    {
      "include": "#keyword-declaration"
    },
    {
      "include": "#keyword-control"
    },
    {
      "include": "#keyword-spirit"
    },
    {
      "include": "#keyword-logic"
    },
    {
      "include": "#constant-language"
    },
    {
      "include": "#builtin-function"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#number"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "builtin-function": {
      "match": "(?i)\\b(LEN|STR|NUM|TYPE|RANDOM|RANGE|PUSH|UPPER|LOWER|SPLIT|JOIN|ASK|BEHOLD|REVERSE|ANCHOR|CONSULT|SHA256|HMAC|BASE64_ENCODE|BASE64_DECODE|TRIM|REPLACE|STARTS_WITH|ENDS_WITH|SUBSTRING|CONTAINS|COUNT|REPEAT|SORT|MIN_OF|MAX_OF|SUM_OF|FIRST|LAST|UNIQUE|INDEX_OF|KEYS|VALUES|HAS_KEY|MERGE|ABS|ROUND|FLOOR|CEIL|SQRT|POW|contract)\\b",
      "name": "support.function.builtin.godcode"
    },
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.godcode"
    },
    "constant-language": {
      "match": "(?i)\\b(TRUE|FALSE|VOID|NNETE|MAAKA|SEPE|IQINISO|AMANGA|LUTHO)\\b",
      "name": "constant.language.godcode"
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "name": "entity.name.function.godcode"
    },
    "keyword-control": {
      "match": "(?i)\\b(IF|THEN|ELSE|ENDIF|FOR|IN|ENDFOR|WHILE|DO|ENDWHILE|DEFINE|INVOKE|RETURN|IMPORT|TRY|CATCH|ENDTRY|BREAK|CONTINUE|FA|TLOGA|GA|FEDISA\\\\s+FA|LEKA|TSHWARA|FEDISA\\\\s+LEKA|KGAOLA|TSWELELA|BITSA|BUSETSA|TSENYA|MO|UMA|KHONA|QEDA\\s+UMA|ZAMA|BAMBA|QEDA\\s+ZAMA|PHULA|QHUBEKA|BIZA|BUYISA|NGENISA|KU|CHAZA)\\b",
      "name": "keyword.control.godcode"
    },
    "keyword-declaration": {
      "match": "(?i)\\b(DECLARE|AS|INTENT|ON|BOLELA|JAAKA|MEMEZELA|NJENGA)\\b",
      "name": "keyword.declaration.godcode"
    },
    "keyword-logic": {
      "match": "(?i)\\b(IS\\s+NOT|IS|NOT|AND|OR|KE|GA|LE|KGOTSA|NGU|HHAYI|KANYE|NOMA)\\b",
      "name": "keyword.operator.logical.godcode"
    },
    "keyword-spirit": {
      "match": "(?i)\\b(BREATHE|LIFE|INTO|REVEAL|PROPHESY|ASCEND|REFLECT|BLESS|ANOINT|SEAL|TESTIFY|HEMA|BOTSHELO|TENG|SENOLA|POROFETA|TLHATLOGA|AKANYA|SEGOFATSA|TLOTSA|TSWALA|PAKA|PHEFUMULA|IMPILO|PHAKATHI|VEZA|PROFETA|ENYUKA|ZINDLA|BUSISA|GCOBA|VALA|FAKAZA)\\b",
      "name": "support.function.godcode"
    },
    "keyword-structure": {
      "match": "(?i)\\b(BEGIN|END|QALA|SIMOLOLA|FEDISA|QEDA)\\s+(CREATION|RITE|TLHOLEGO|TIRO|INDALO|ISIKO)\\b|(?i)\\b(CREATION|RITE|TLHOLEGO|TIRO|INDALO|ISIKO)\\b",
      "name": "storage.type.godcode"
    },
    "number": {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.godcode"
    },
    "operator": {
      "match": "(\\+|-|\\*|/|%|==|!=|<=|>=|=|<|>)",
      "name": "keyword.operator.godcode"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.godcode",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.godcode"
        }
      ]
    }
  },
  "scopeName": "source.godcode"
}
